/*
 * Plain CSS: design tokens as custom properties, then a few shared building blocks (layout, card,
 * button, form, alert) used by the pages. Colors follow the OS light/dark setting.
 */

:root {
    color-scheme: light dark;
    --color-bg: #f9fafb;
    --color-surface: #ffffff;
    --color-text: #111827;
    --color-muted: #6b7280;
    --color-border: #e5e7eb;
    --color-hover: #f3f4f6;
    --color-primary: #4f46e5;
    --color-primary-hover: #4338ca;
    --color-danger: #dc2626;
    --color-success-bg: #f0fdf4;
    --color-success-border: #bbf7d0;
    --color-success-text: #166534;
    --radius: 0.5rem;
    --font-sans: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
}

@media (prefers-color-scheme: dark) {
    :root {
        --color-bg: #030712;
        --color-surface: #111827;
        --color-text: #f3f4f6;
        --color-muted: #9ca3af;
        --color-border: #1f2937;
        --color-hover: #1f2937;
        --color-primary: #6366f1;
        --color-primary-hover: #4f46e5;
        --color-danger: #f87171;
        --color-success-bg: #052e16;
        --color-success-border: #14532d;
        --color-success-text: #bbf7d0;
    }
}

*,
*::before,
*::after {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
}

a {
    color: inherit;
    text-decoration: none;
}

h1,
h2,
h3,
p {
    margin: 0;
}

h1 {
    font-size: 1.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
}

code {
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    background: var(--color-hover);
    font-size: 0.875em;
}

/* Layout */
.container {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1rem;
}

.app-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
}

.navbar > .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
}

.navbar-brand {
    font-size: 1.125rem;
    font-weight: 600;
}

.navbar-nav {
    display: flex;
    gap: 0.25rem;
}

.nav-link {
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    color: var(--color-muted);
}

.nav-link:hover {
    background: var(--color-hover);
    color: var(--color-text);
}

.nav-link.active {
    color: var(--color-text);
    font-weight: 500;
}

.app-main {
    padding-block: 2rem;
}

.page-header {
    margin-bottom: 1.5rem;
}

.page-header p,
.lead {
    color: var(--color-muted);
}

.page-header p {
    margin-top: 0.25rem;
}

.lead {
    margin-bottom: 1.5rem;
    font-size: 1.125rem;
}

/* Card */
.card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: 0 1px 2px rgb(0 0 0 / 5%);
}

.card-body {
    padding: 1.25rem;
}

.card-title {
    margin-bottom: 0.75rem;
    font-size: 1.125rem;
    font-weight: 600;
}

h1.card-title {
    font-size: 1.875rem;
}

.card-text {
    margin-bottom: 0.75rem;
    white-space: pre-line;
}

/* Buttons */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    border: 1px solid transparent;
    border-radius: 0.375rem;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    transition:
        background-color 0.15s,
        color 0.15s;
}

.btn:disabled {
    cursor: not-allowed;
    opacity: 0.6;
}

.btn-sm {
    padding: 0.25rem 0.625rem;
    font-size: 0.875rem;
}

.btn-primary {
    background: var(--color-primary);
    color: #fff;
}

.btn-primary:hover:not(:disabled) {
    background: var(--color-primary-hover);
}

.btn-outline-danger {
    border-color: var(--color-danger);
    background: transparent;
    color: var(--color-danger);
}

.btn-outline-danger:hover:not(:disabled) {
    background: var(--color-danger);
    color: #fff;
}

/* Forms */
.field {
    margin-bottom: 1rem;
}

.form-label {
    display: block;
    margin-bottom: 0.25rem;
    font-weight: 500;
}

.form-control {
    display: block;
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-bg);
    color: inherit;
    font: inherit;
}

.form-control:focus {
    border-color: var(--color-primary);
    outline: none;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 25%, transparent);
}

.form-control.is-invalid {
    border-color: var(--color-danger);
}

.invalid-feedback {
    margin-top: 0.25rem;
    color: var(--color-danger);
    font-size: 0.875rem;
}

/* Alerts */
.alert {
    margin-bottom: 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid transparent;
    border-radius: 0.375rem;
}

.alert-success {
    border-color: var(--color-success-border);
    background: var(--color-success-bg);
    color: var(--color-success-text);
}

/* Notes */
.notes-layout {
    display: grid;
    gap: 1.5rem;
    align-items: start;
}

@media (min-width: 768px) {
    .notes-layout {
        grid-template-columns: 20rem 1fr;
    }
}

.note-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
}

.note-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
}

.note-date {
    color: var(--color-muted);
    font-size: 0.875rem;
}

.empty-state {
    padding: 2rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    color: var(--color-muted);
    text-align: center;
}
