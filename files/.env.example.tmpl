# The app's name: page titles and the header (config('app.name'), shared with every page).
APP_NAME=Laravel
APP_ENV=local
# Encryption key, generated by `php artisan key:generate` during setup. Never commit or share it.
APP_KEY=
APP_DEBUG=true
# Public URL of the app; keep its port equal to APP_PORT.
APP_URL=http://localhost:8000
# Port of the app: `php artisan serve` in development{% if choices.docker != "none" %}, the published port of the containers{% endif %}.
APP_PORT=8000
# Port of the Vite dev server (hot reload of pages, components and styles).
VITE_PORT=5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
{% if choices.database == "sqlite" %}
# SQLite database file, relative to the project root{% if choices.docker != "none" %} (data/ is mounted into the containers){% endif %}.
DB_CONNECTION=sqlite
DB_DATABASE=data/database.sqlite
{%- elif choices.docker == "none" %}
# The {% if choices.database == "postgres" %}PostgreSQL{% else %}MySQL{% endif %} server on this machine: create the database and set the credentials.
DB_CONNECTION={% if choices.database == "postgres" %}pgsql{% else %}mysql{% endif %}
DB_HOST=127.0.0.1
DB_PORT={% if choices.database == "postgres" %}5432{% else %}3306{% endif %}
DB_DATABASE=laravel
DB_USERNAME={% if choices.database == "postgres" %}postgres{% else %}root{% endif %}
DB_PASSWORD=
{%- else %}
# {% if choices.database == "postgres" %}PostgreSQL{% else %}MySQL{% endif %} in the `db` container, created with these credentials on its first start.
{%- if choices.docker == "full" %}
# PHP runs in containers and reaches it as db:{% if choices.database == "postgres" %}5432{% else %}3306{% endif %}; database tools on this machine use 127.0.0.1:FORWARD_DB_PORT.
{%- else %}
# PHP on this machine reaches it on 127.0.0.1:FORWARD_DB_PORT; the app container uses db:{% if choices.database == "postgres" %}5432{% else %}3306{% endif %} (docker-compose.yml).
{%- endif %}
DB_CONNECTION={% if choices.database == "postgres" %}pgsql{% else %}mysql{% endif %}
DB_HOST=127.0.0.1
DB_PORT={% if choices.database == "postgres" %}5432{% else %}3306{% endif %}
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=password
{%- endif %}
{%- if choices.database != "sqlite" %}
# Port of the `db` container on this machine{% if choices.docker == "none" %} (used only with Docker){% endif %}.
FORWARD_DB_PORT={% if choices.database == "postgres" %}5432{% else %}3306{% endif %}
{%- endif %}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Jobs run immediately; switch to `database` and run `php artisan queue:work` for background jobs.
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# For frontend code at build time (import.meta.env.VITE_APP_NAME); pages use the shared prop appName
# (Vite expands $VAR in .env values, even in single quotes; Laravel reads APP_NAME literally).
VITE_APP_NAME="${APP_NAME}"
{%- if choices.docker != "none" %}

# Docker Compose project name: prefix of the containers, volumes and images.
COMPOSE_PROJECT_NAME=laravel
# Where containers keep data: "data" (a named Docker volume) or "./data" (the project's data/ folder).
DOCKER_DATA=data
{%- endif %}
